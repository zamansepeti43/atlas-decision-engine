{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "artifacts/atlas-ai/package.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/artifacts/api-server/api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/atlas-ai/dist/$1"
    }
  ],
  "outputDirectory": "artifacts/atlas-ai/dist"
}