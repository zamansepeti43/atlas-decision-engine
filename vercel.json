{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/api/index.ts",
      "use": "@vercel/node@5.9.7"
    },
    {
      "src": "artifacts/atlas-ai/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api(?:/(.*))?",
      "dest": "/artifacts/api-server/api/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/artifacts/atlas-ai/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/artifacts/atlas-ai/favicon.svg"
    },
    {
      "src": "/robots.txt",
      "dest": "/artifacts/atlas-ai/robots.txt"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/artifacts/atlas-ai/index.html"
    }
  ]
}
